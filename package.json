{
  "name": "pedidoja-projeto-integrador",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "PedidoJá: gestão de pedidos com Telegram, ViaCEP e PostgreSQL",
  "engines": {"node": ">=20"},
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "worker": "node src/worker.js",
    "db:migrate": "node src/migrate.js",
    "webhook:registrar": "node scripts/register-webhook.js",
    "demo:seed": "node scripts/demo-seed.js",
    "test": "node --test tests/*.test.js",
    "lint": "eslint .",
    "check": "npm run lint && npm test"
  },
  "dependencies": {
    "dotenv": "16.4.7",
    "express": "4.21.2",
    "helmet": "8.0.0",
    "pg": "8.13.3"
  },
  "devDependencies": {
    "@eslint/js": "9.18.0",
    "eslint": "9.18.0",
    "globals": "15.14.0"
  }
}
